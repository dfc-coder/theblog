---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPostPath,
  getPublishedPosts,
  resolvePostSlug
} from '../../lib/blog';
import { SITE } from '../../lib/site';

type Props = {
  entry: CollectionEntry<'blog'>;
};

export async function getStaticPaths() {
  const posts = getPublishedPosts(await getCollection('blog'));

  return posts.map((entry) => ({
    params: { slug: resolvePostSlug(entry) },
    props: { entry }
  }));
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
const canonicalPath = getPostPath(entry);
---

<BaseLayout
  title={`${entry.data.title} · ${SITE.name}`}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  type="article"
>
  <article class="article-shell">
    <header class="article-header container">
      <a class="article-back" href="/#archivo">← Archivo</a>
      <div class="article-kicker">
        <span>ARTICLE / {entry.data.pubDate.getFullYear()}</span>
        <time datetime={entry.data.pubDate.toISOString()}>
          {entry.data.pubDate.toLocaleDateString('es-AR', { dateStyle: 'long' })}
        </time>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="article-deck">{entry.data.description}</p>

      {
        entry.data.tags.length > 0 && (
          <ul class="tag-list" aria-label="Etiquetas del post">
            {entry.data.tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="article-rule" aria-hidden="true">
      <span>READ / THINK / BUILD</span>
    </div>

    <div class="article-content container">
      <Content />
    </div>
  </article>
</BaseLayout>
