---
import { SITE } from '../lib/site';

const nav = [
  { href: '/', label: 'Inicio' },
  { href: '/rss.xml', label: 'RSS' }
];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">{SITE.name}</a>
    <nav aria-label="Principal">
      <ul class="nav-list">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
