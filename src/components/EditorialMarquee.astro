---
import '../styles/marquee.css';

const items = [
  'AGENTES',
  'ARQUITECTURA',
  'INTEGRACIONES',
  'IA APLICADA',
  'SISTEMAS',
  'PRODUCCIÓN',
  'OBSERVABILIDAD',
  'FIABILIDAD'
] as const;
---

<section class="editorial-marquee" aria-label="Temas del blog">
  <div class="marquee-label" aria-hidden="true">
    <span>EN ESTE BLOG</span>
    <span class="marquee-label-arrow">→</span>
  </div>

  <div class="marquee-viewport">
    <p class="sr-only">Temas del blog: {items.join(', ')}.</p>
    <div class="marquee-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="marquee-group">
          {items.map((item) => <span class="marquee-item">{item}</span>)}
        </div>
      ))}
    </div>
  </div>
</section>
