<button
  class="back-to-top"
  id="back-to-top"
  type="button"
  aria-label="Volver al inicio de la página"
  hidden
>
  <span>UP TOP</span>
  <span aria-hidden="true">↑</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#back-to-top');

  if (button) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;
    let scrollingToTop = false;

    const updateVisibility = () => {
      const threshold = Math.max(window.innerHeight * 0.75, 560);
      button.hidden = !scrollingToTop && window.scrollY < threshold;
      ticking = false;
    };

    const handleScroll = () => {
      if (ticking) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(updateVisibility);
    };

    const easeOutQuint = (progress: number): number => 1 - Math.pow(1 - progress, 5);
    const easeInCubic = (progress: number): number => progress * progress * progress;

    const scrollToTop = () => {
      if (reducedMotion.matches) {
        window.scrollTo(0, 0);
        return;
      }

      const startY = window.scrollY;
      if (startY <= 0 || scrollingToTop) {
        return;
      }

      const impulseDistance = Math.min(34, Math.max(18, startY * 0.015));
      const impulseTarget = Math.min(
        startY + impulseDistance,
        document.documentElement.scrollHeight - window.innerHeight
      );
      const impulseDuration = 120;
      const travelDuration = Math.min(780, Math.max(440, startY * 0.22));
      const startedAt = performance.now();

      scrollingToTop = true;
      button.hidden = false;

      const impulseStep = (now: number) => {
        const progress = Math.min((now - startedAt) / impulseDuration, 1);
        const eased = easeInCubic(progress);
        const currentY = startY + (impulseTarget - startY) * eased;
        window.scrollTo(0, currentY);

        if (progress < 1) {
          window.requestAnimationFrame(impulseStep);
          return;
        }

        const ascentStart = performance.now();
        const ascentStartY = window.scrollY;

        const ascentStep = (ascentNow: number) => {
          const ascentProgress = Math.min((ascentNow - ascentStart) / travelDuration, 1);
          const ascentEased = easeOutQuint(ascentProgress);
          window.scrollTo(0, ascentStartY * (1 - ascentEased));

          if (ascentProgress < 1) {
            window.requestAnimationFrame(ascentStep);
            return;
          }

          window.scrollTo(0, 0);
          scrollingToTop = false;
          updateVisibility();
        };

        window.requestAnimationFrame(ascentStep);
      };

      window.requestAnimationFrame(impulseStep);
    };

    button.addEventListener('click', scrollToTop);
    window.addEventListener('scroll', handleScroll, { passive: true });
    updateVisibility();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 2vw, 2rem);
    bottom: clamp(1rem, 2vw, 2rem);
    z-index: 40;
    display: inline-flex;
    min-height: 54px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-2px);
  }

  .back-to-top span:last-child {
    color: var(--accent);
    font-size: 1.1rem;
    line-height: 1;
  }

  .back-to-top:hover span:last-child {
    color: inherit;
  }

  @media (max-width: 760px) {
    .back-to-top {
      min-height: 48px;
      padding: 0.78rem 0.9rem;
      font-size: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
