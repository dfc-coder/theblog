<button
  class="back-to-top"
  id="back-to-top"
  type="button"
  aria-label="Volver al inicio de la página"
  hidden
>
  <span>UP TOP</span>
  <span aria-hidden="true">↑</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#back-to-top');

  if (button) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const visibilityViewportRatio = 0.75;
    const impulseViewportRatio = 0.045;
    const minimumTravelDuration = 440;
    const maximumTravelDuration = 780;
    const impulseDuration = 120;
    let ticking = false;
    let scrollingToTop = false;

    const updateVisibility = () => {
      const threshold = window.innerHeight * visibilityViewportRatio;
      button.hidden = !scrollingToTop && window.scrollY < threshold;
      ticking = false;
    };

    const handleScroll = () => {
      if (ticking) {
        return;
      }

      ticking = true;
      window.requestAnimationFrame(updateVisibility);
    };

    const easeOutQuint = (progress: number): number => 1 - Math.pow(1 - progress, 5);
    const easeInCubic = (progress: number): number => progress * progress * progress;

    const scrollToTop = () => {
      if (reducedMotion.matches) {
        window.scrollTo(0, 0);
        return;
      }

      const startY = window.scrollY;
      if (startY <= 0 || scrollingToTop) {
        return;
      }

      const viewportHeight = Math.max(window.innerHeight, 1);
      const maximumScrollY = document.documentElement.scrollHeight - viewportHeight;
      const impulseDistance = viewportHeight * impulseViewportRatio;
      const impulseTarget = Math.min(startY + impulseDistance, maximumScrollY);
      const viewportDistance = startY / viewportHeight;
      const travelDuration = Math.min(
        maximumTravelDuration,
        minimumTravelDuration + viewportDistance * 70
      );
      const startedAt = performance.now();

      scrollingToTop = true;
      button.hidden = false;

      const impulseStep = (now: number) => {
        const progress = Math.min((now - startedAt) / impulseDuration, 1);
        const eased = easeInCubic(progress);
        const currentY = startY + (impulseTarget - startY) * eased;
        window.scrollTo(0, currentY);

        if (progress < 1) {
          window.requestAnimationFrame(impulseStep);
          return;
        }

        const ascentStart = performance.now();
        const ascentStartY = window.scrollY;

        const ascentStep = (ascentNow: number) => {
          const ascentProgress = Math.min((ascentNow - ascentStart) / travelDuration, 1);
          const ascentEased = easeOutQuint(ascentProgress);
          window.scrollTo(0, ascentStartY * (1 - ascentEased));

          if (ascentProgress < 1) {
            window.requestAnimationFrame(ascentStep);
            return;
          }

          window.scrollTo(0, 0);
          scrollingToTop = false;
          updateVisibility();
        };

        window.requestAnimationFrame(ascentStep);
      };

      window.requestAnimationFrame(impulseStep);
    };

    button.addEventListener('click', scrollToTop);
    window.addEventListener('scroll', handleScroll, { passive: true });
    updateVisibility();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: clamp(1rem, 2vw, 2rem);
    bottom: clamp(1rem, 2vw, 2rem);
    z-index: 40;
    display: inline-flex;
    min-block-size: clamp(3.25rem, 3rem + 1vw, 3.75rem);
    align-items: center;
    gap: 0.75em;
    padding-block: clamp(0.8rem, 0.7rem + 0.35vw, 1rem);
    padding-inline: clamp(1rem, 0.9rem + 0.5vw, 1.35rem);
    border: 0.0625rem solid var(--line-strong);
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.72rem, 0.68rem + 0.2vw, 0.82rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--accent-ink);
    transform: translateY(-0.125rem);
  }

  .back-to-top span:last-child {
    color: var(--accent);
    font-size: 1.45em;
    line-height: 1;
  }

  .back-to-top:hover span:last-child {
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }
</style>
