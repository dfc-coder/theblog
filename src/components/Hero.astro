---
import HeroGraph from './HeroGraph.astro';
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow"><span>00</span> SOFTWARE / AI / SYSTEMS</p>
    <h1 id="hero-title">Ingeniería para sistemas que sobreviven a la realidad.</h1>
    <p class="hero-intro">
      Arquitectura, integraciones, inteligencia artificial y decisiones técnicas explicadas desde
      producción: qué funciona, qué falla y por qué.
    </p>
    <a class="text-link" href="#archivo">Explorar el archivo <span aria-hidden="true">↓</span></a>
  </div>

  <div class="hero-visual">
    <HeroGraph />
    <p class="visual-caption">
      <span>FIG. 001</span> REALIDAD → OBSERVAR → DECIDIR → IMPLEMENTAR → PRODUCCIÓN → APRENDER
    </p>
  </div>
</section>
